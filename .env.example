# ComplianceShield Environment Variables Template
# Copy this file to .env and configure your local development environment
# Never commit .env or live production credentials to version control.

# Application Configuration
NODE_ENV=development
PORT=3000

# Cloud Infrastructure (Mock Sandbox / Local Development)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/compliance_shield_dev

# External API Integrations (Mock Test Tokens)
STRIPE_SECRET_KEY=mock_sandbox_stripe_test_token
OPENAI_API_KEY=mock_sandbox_openai_test_token
JWT_SECRET=mock_sandbox_jwt_development_secret_key
